# Copy this file's variable names into Vercel: Project Settings -> Environment Variables
# Do NOT commit a real .env file with actual secrets to GitHub.

# Your MongoDB Atlas connection string (from Atlas dashboard -> Connect -> Drivers)
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name (optional, defaults to "astrokashi" if not set)
MONGODB_DB=astrokashi

# A password you make up yourself, used to view bookings/messages via the API.
# Keep this secret. Example: choose any long random string.
ADMIN_KEY=

# --- Email notifications (booking/enquiry/review confirmations) ---
# The Gmail account that will SEND these emails.
GMAIL_USER=astrokashi369@gmail.com

# A Gmail "App Password" (NOT your normal Gmail password) - 16 characters, no spaces.
# How to get one:
#   1. On astrokashi369@gmail.com: Google Account -> Security -> turn on 2-Step Verification.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password (name it "Adhbhut Gyaan Website"), copy the code shown.
GMAIL_APP_PASSWORD=

# Optional: where admin notification emails are sent. Defaults to GMAIL_USER if not set.
ADMIN_NOTIFY_EMAIL=astrokashi369@gmail.com

# --- Admin WhatsApp alerts (via CallMeBot - free, no business account needed) ---
# Setup: save +34 621 74 96 96 as a contact on the phone that should get alerts,
# WhatsApp it the exact text "I allow callmebot to send me messages", and it
# replies with your personal API key within about a minute.
CALLMEBOT_PHONE=919278148269
CALLMEBOT_APIKEY=

# --- Google Gemini AI Engine (Vedic Astrology Q&A & Horoscope Chatbot) ---
# Get a free or standard API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Powers the AI Astrologer Q&A, Rashi Horoscope, and Puja Recommendations.
GEMINI_API_KEY=

# --- Anthropic Claude AI (Alternative assistant engine) ---
# Get a key from https://console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=

# --- WhatsApp bot (same AI, but replies directly on WhatsApp) ---
# Requires a Meta for Developers app with the WhatsApp product added.
# See the setup comment at the top of api/whatsapp-webhook.js for the
# full step-by-step. Uses the same ANTHROPIC_API_KEY above.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

